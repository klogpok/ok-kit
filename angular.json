{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-kit": {
      "projectType": "library",
      "root": "projects/ui-kit",
      "sourceRoot": "projects/ui-kit",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui-kit/tsconfig.spec.json",
            "buildTarget": "::development",
            "runner": "vitest",
            "providersFile": "projects/ui-kit/test-setup/providers.ts",
            "codeCoverageExclude": [
              "**/*.stories.ts",
              "**/tokens.generated.ts"
            ],
            "codeCoverageReporters": ["text", "html", "json", "json-summary"],
            "setupFiles": [
              "projects/ui-kit/test-setup/jsdom-event-view.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ui-kit/**/*.ts",
              "projects/ui-kit/**/*.html",
              "projects/ui-kit/**/*.mts"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "ui-kit:build-storybook",
            "configDir": "projects/ui-kit/.storybook",
            "tsConfig": "projects/ui-kit/.storybook/tsconfig.json",
            "styles": [
              "node_modules/@fontsource/assistant/400.css",
              "node_modules/@fontsource/assistant/500.css",
              "node_modules/@fontsource/assistant/600.css",
              "node_modules/@fontsource/assistant/700.css",
              "projects/ui-kit/styles/ui-kit.scss"
            ],
            "port": 6006,
            "compodoc": false,
            "experimentalZoneless": true
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/ui-kit/.storybook",
            "tsConfig": "projects/ui-kit/.storybook/tsconfig.json",
            "styles": [
              "node_modules/@fontsource/assistant/400.css",
              "node_modules/@fontsource/assistant/500.css",
              "node_modules/@fontsource/assistant/600.css",
              "node_modules/@fontsource/assistant/700.css",
              "projects/ui-kit/styles/ui-kit.scss"
            ],
            "outputDir": "dist/storybook/ui-kit",
            "compodoc": false,
            "experimentalZoneless": true
          }
        }
      }
    },
    "playground": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/playground",
      "sourceRoot": "projects/playground/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/playground/src/main.ts",
            "tsConfig": "projects/playground/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/playground/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/assistant/400.css",
              "node_modules/@fontsource/assistant/500.css",
              "node_modules/@fontsource/assistant/600.css",
              "node_modules/@fontsource/assistant/700.css",
              "projects/ui-kit/styles/ui-kit.scss",
              "projects/playground/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "playground:build:production"
            },
            "development": {
              "buildTarget": "playground:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/playground/tsconfig.spec.json",
            "buildTarget": "::development",
            "runner": "vitest",
            "providersFile": "projects/playground/src/test-providers.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/playground/**/*.ts",
              "projects/playground/**/*.html"
            ]
          }
        }
      }
    }
  }
}
