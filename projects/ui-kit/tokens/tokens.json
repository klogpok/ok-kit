        "500": "#f59e0b", "600": "#d97706", "700": "#b45309", "800": "#92400e", "900": "#78350f", "950": "#451a03"
      },
      "sky": {
        "50": "#f0f9ff", "100": "#e0f2fe", "200": "#bae6fd", "300": "#7dd3fc", "400": "#38bdf8",
        "500": "#0ea5e9", "600": "#0284c7", "700": "#0369a1", "800": "#075985", "900": "#0c4a6e", "950": "#082f49"
      }
    },
    "space": {
      "0": "0", "0-5": "0.125rem", "1": "0.25rem", "1-5": "0.375rem", "2": "0.5rem", "2-5": "0.625rem", "3": "0.75rem",
      "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "9": "2.25rem", "10": "2.5rem", "12": "3rem", "16": "4rem"
    },
    "size": {
      "px": "1px", "2px": "2px", "3": "0.75rem", "3-5": "0.875rem", "4": "1rem", "4-5": "1.125rem", "5": "1.25rem",
      "6": "1.5rem", "8": "2rem", "9": "2.25rem", "10": "2.5rem", "11": "2.75rem"
    },
    "radius": {
      "none": "0", "sm": "0.25rem", "md": "0.375rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"
    },
    "font-family": {
      "sans": "'Inter', 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans Hebrew', Arial, sans-serif",
      "mono": "ui-monospace, 'JetBrains Mono', 'Cascadia Code', Consolas, monospace"
    },
    "font-size": {
      "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.25rem",
      "2xl": "1.5rem", "3xl": "1.875rem", "4xl": "2.25rem"
    },
    "font-weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "line-height": { "tight": "1.25", "snug": "1.375", "normal": "1.5" },
    "shadow": {
      "sm": "0 1px 2px 0 rgb(15 23 42 / 0.06)",
      "md": "0 4px 8px -2px rgb(15 23 42 / 0.10), 0 2px 4px -2px rgb(15 23 42 / 0.06)",
      "lg": "0 12px 24px -6px rgb(15 23 42 / 0.16), 0 4px 8px -4px rgb(15 23 42 / 0.08)",
      "dark-sm": "0 1px 2px 0 rgb(0 0 0 / 0.4)",
      "dark-md": "0 4px 8px -2px rgb(0 0 0 / 0.5)",
      "dark-lg": "0 12px 24px -6px rgb(0 0 0 / 0.6)"
