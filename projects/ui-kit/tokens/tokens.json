    "z": { "base": "0", "raised": "10", "dropdown": "1000", "sticky": "1100", "overlay": "1200", "modal": "1300", "toast": "1400", "tooltip": "1500" },
    "duration": { "instant": "50ms", "fast": "120ms", "normal": "200ms", "slow": "320ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "semantic": {
    "base": {
      "font-family": { "sans": "{font-family.sans}", "mono": "{font-family.mono}" },
      "font-size": {
        "xs": "{font-size.xs}", "sm": "{font-size.sm}", "md": "{font-size.md}", "lg": "{font-size.lg}", "xl": "{font-size.xl}",
        "2xl": "{font-size.2xl}", "3xl": "{font-size.3xl}", "4xl": "{font-size.4xl}"
      },
      "font-weight": { "regular": "{font-weight.regular}", "medium": "{font-weight.medium}", "semibold": "{font-weight.semibold}", "bold": "{font-weight.bold}" },
      "line-height": { "tight": "{line-height.tight}", "snug": "{line-height.snug}", "normal": "{line-height.normal}" },
      "space": {
        "3xs": "{space.0-5}", "2xs": "{space.1}", "xs": "{space.1-5}", "sm": "{space.2}", "md": "{space.3}",
        "lg": "{space.4}", "xl": "{space.6}", "2xl": "{space.8}", "3xl": "{space.12}"
      },
      "radius": { "sm": "{radius.sm}", "control": "{radius.md}", "container": "{radius.lg}", "full": "{radius.full}" },
      "border-width": { "default": "{size.px}", "strong": "{size.2px}" },
      "focus-ring": { "width": "{size.2px}", "offset": "{size.2px}" },
      "control": {
        "height": { "sm": "{size.8}", "md": "{size.10}", "lg": "{size.11}" },
        "padding-inline": { "sm": "{space.2-5}", "md": "{space.3}", "lg": "{space.4}" },
        "font-size": { "sm": "{font-size.sm}", "md": "{font-size.sm}", "lg": "{font-size.md}" },
        "gap": { "sm": "{space.1-5}", "md": "{space.2}", "lg": "{space.2-5}" }
      },
      "icon-size": { "sm": "{size.4}", "md": "{size.5}", "lg": "{size.6}" },
      "z": {
        "raised": "{z.raised}", "dropdown": "{z.dropdown}", "sticky": "{z.sticky}", "overlay": "{z.overlay}",
        "modal": "{z.modal}", "toast": "{z.toast}", "tooltip": "{z.tooltip}"
      },
      "motion": {
        "duration": { "instant": "{duration.instant}", "fast": "{duration.fast}", "normal": "{duration.normal}", "slow": "{duration.slow}" },
        "easing": { "standard": "{easing.standard}", "enter": "{easing.enter}", "exit": "{easing.exit}" }
      }
    },
    "light": {
      "color-scheme": "light",
      "color": {
        "bg": "{color.white}",
        "surface": "{color.white}",
        "surface-subtle": "{color.slate.50}",
        "surface-muted": "{color.slate.100}",
        "surface-raised": "{color.white}",
        "surface-hover": "{color.slate.100}",
        "surface-active": "{color.slate.200}",
        "text": "{color.slate.900}",
        "text-muted": "{color.slate.600}",
        "text-subtle": "{color.slate.500}",
        "text-disabled": "{color.slate.400}",
        "text-inverse": "{color.white}",
        "border": "{color.slate.200}",
        "border-control": "{color.slate.500}",
        "border-control-hover": "{color.slate.700}",
        "control-bg": "{color.white}",
        "control-bg-disabled": "{color.slate.100}",
        "primary": "{color.indigo.600}",
        "primary-hover": "{color.indigo.700}",
        "primary-active": "{color.indigo.800}",
        "primary-contrast": "{color.white}",
        "primary-subtle": "{color.indigo.50}",
        "primary-subtle-hover": "{color.indigo.100}",
        "primary-text": "{color.indigo.700}",
        "danger": "{color.red.600}",
        "danger-hover": "{color.red.700}",
        "danger-active": "{color.red.800}",
        "danger-contrast": "{color.white}",
        "danger-subtle": "{color.red.50}",
        "danger-text": "{color.red.700}",
        "success": "{color.green.700}",
        "success-contrast": "{color.white}",
        "success-subtle": "{color.green.50}",
        "success-text": "{color.green.700}",
        "warning": "{color.amber.500}",
        "warning-contrast": "{color.slate.950}",
        "warning-subtle": "{color.amber.50}",
        "warning-text": "{color.amber.800}",
        "info": "{color.sky.700}",
        "info-contrast": "{color.white}",
        "info-subtle": "{color.sky.50}",
        "info-text": "{color.sky.800}",
        "focus-ring": "{color.indigo.600}",
        "backdrop": "rgb(15 23 42 / 0.5)"
      },
      "shadow": { "sm": "{shadow.sm}", "md": "{shadow.md}", "lg": "{shadow.lg}" }
