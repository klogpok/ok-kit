        "surface-raised": "{color.slate.800}",
        "surface-hover": "{color.slate.800}",
        "surface-active": "{color.slate.700}",
        "text": "{color.slate.50}",
        "text-muted": "{color.slate.400}",
        "text-subtle": "{color.slate.400}",
        "text-disabled": "{color.slate.600}",
        "text-inverse": "{color.slate.900}",
        "border": "{color.slate.800}",
        "border-control": "{color.slate.500}",
        "border-control-hover": "{color.slate.300}",
        "control-bg": "{color.slate.900}",
        "control-bg-disabled": "{color.slate.800}",
        "primary": "{color.indigo.400}",
        "primary-hover": "{color.indigo.300}",
        "primary-active": "{color.indigo.200}",
        "primary-contrast": "{color.slate.950}",
        "primary-subtle": "{color.indigo.950}",
        "primary-subtle-hover": "{color.indigo.900}",
        "primary-text": "{color.indigo.300}",
        "danger": "{color.red.400}",
        "danger-hover": "{color.red.300}",
        "danger-active": "{color.red.200}",
        "danger-contrast": "{color.slate.950}",
        "danger-subtle": "{color.red.950}",
        "danger-text": "{color.red.300}",
        "success": "{color.green.400}",
        "success-contrast": "{color.slate.950}",
        "success-subtle": "{color.green.950}",
        "success-text": "{color.green.300}",
        "warning": "{color.amber.400}",
        "warning-contrast": "{color.slate.950}",
        "warning-subtle": "{color.amber.950}",
        "warning-text": "{color.amber.300}",
        "info": "{color.sky.400}",
        "info-contrast": "{color.slate.950}",
        "info-subtle": "{color.sky.950}",
        "info-text": "{color.sky.300}",
        "focus-ring": "{color.indigo.400}",
        "backdrop": "rgb(0 0 0 / 0.6)"
      },
      "shadow": { "sm": "{shadow.dark-sm}", "md": "{shadow.dark-md}", "lg": "{shadow.dark-lg}" }
    }
  },
  "component": {
    "button": {
      "radius": "{radius.control}",
      "font-weight": "{font-weight.medium}",
      "primary": { "bg": "{color.primary}", "bg-hover": "{color.primary-hover}", "bg-active": "{color.primary-active}", "text": "{color.primary-contrast}", "border": "transparent" },
      "secondary": { "bg": "{color.surface}", "bg-hover": "{color.surface-hover}", "bg-active": "{color.surface-active}", "text": "{color.text}", "border": "{color.border-control}" },
      "ghost": { "bg": "transparent", "bg-hover": "{color.surface-hover}", "bg-active": "{color.surface-active}", "text": "{color.text}", "border": "transparent" },
      "danger": { "bg": "{color.danger}", "bg-hover": "{color.danger-hover}", "bg-active": "{color.danger-active}", "text": "{color.danger-contrast}", "border": "transparent" }
    },
    "input": {
      "bg": "{color.control-bg}",
      "bg-disabled": "{color.control-bg-disabled}",
      "text": "{color.text}",
      "placeholder": "{color.text-subtle}",
      "border": "{color.border-control}",
      "border-hover": "{color.border-control-hover}",
      "border-focus": "{color.primary}",
      "border-invalid": "{color.danger}",
      "radius": "{radius.control}"
    },
    "form-field": {
      "gap": "{space.2xs}",
      "label-color": "{color.text}",
      "label-font-size": "{font-size.sm}",
      "label-font-weight": "{font-weight.medium}",
      "hint-color": "{color.text-muted}",
      "error-color": "{color.danger-text}",
      "message-font-size": "{font-size.xs}"
    },
    "checkbox": {
      "size": "{icon-size.sm}",
      "radius": "{radius.sm}",
      "bg": "{color.control-bg}",
      "border": "{color.border-control}",
      "checked-bg": "{color.primary}",
      "checked-color": "{color.primary-contrast}",
      "invalid-border": "{color.danger}"
    },
    "radio": {
      "size": "{icon-size.sm}",
      "bg": "{color.control-bg}",
      "border": "{color.border-control}",
      "checked-color": "{color.primary}",
      "invalid-border": "{color.danger}"
    },
    "switch": {
      "track-width": "{control.height.md}",
      "track-height": "{icon-size.md}",
      "track-bg": "{color.border-control}",
      "track-checked-bg": "{color.primary}",
      "thumb-bg": "{color.control-bg}",
      "invalid-outline": "{color.danger}"
    },
    "spinner": {
      "track-color": "{color.border}",
      "stroke-width": "{border-width.strong}"
    }
