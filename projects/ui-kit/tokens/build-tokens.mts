/**
 * Generates CSS/SCSS/TS artifacts from tokens.json and validates WCAG contrast.
 * Run: `pnpm tokens` (Node >= 22.18 strips TypeScript types natively).
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

interface TokenTree {
  [key: string]: string | TokenTree;
}

interface TokenFile {
  breakpoint: TokenTree;
  primitive: TokenTree;
  semantic: { base: TokenTree; light: TokenTree; dark: TokenTree; compact: TokenTree };
  component: TokenTree;
  'component-compact': TokenTree;
}

interface FlatToken {
  path: string;
  value: string;
}

export interface TokenDoc {
  name: string;
  layer: 'primitive' | 'semantic' | 'component';
  light: string;
  dark: string;
  /** The value inside `[data-density='compact']`, for the tokens density changes. */
  compact?: string;
}

const here = dirname(fileURLToPath(import.meta.url));
const libRoot = resolve(here, '..');
const tokens = JSON.parse(readFileSync(resolve(here, 'tokens.json'), 'utf8')) as TokenFile;

const REF = /\{([^}]+)\}/g;
const THEME_PROPERTIES = new Set(['color-scheme']);

function flatten(tree: TokenTree, prefix = ''): FlatToken[] {
  return Object.entries(tree).flatMap(([key, value]) => {
    if (key.startsWith('$')) return [];
    const path = prefix ? `${prefix}.${key}` : key;
    return typeof value === 'string' ? [{ path, value }] : flatten(value, path);
  });
}

const cssName = (layerPrefix: string, path: string): string =>
  `--ui-${layerPrefix}${path.replaceAll('.', '-')}`;

const primitives = flatten(tokens.primitive);
const primitiveMap = new Map(primitives.map((t) => [t.path, t.value]));
const base = flatten(tokens.semantic.base);
const light = flatten(tokens.semantic.light);
const dark = flatten(tokens.semantic.dark);
const component = flatten(tokens.component);
const compact = flatten(tokens.semantic.compact);
const componentCompact = flatten(tokens['component-compact']);

const semanticPaths = new Set([...base, ...light, ...dark].map((t) => t.path));
const componentPaths = new Set(component.map((t) => t.path));

function assertSameKeys(a: FlatToken[], b: FlatToken[]): void {
  const aKeys = new Set(a.map((t) => t.path));
  const bKeys = new Set(b.map((t) => t.path));
  const missing = [...aKeys]
    .filter((k) => !bKeys.has(k))
    .concat([...bKeys].filter((k) => !aKeys.has(k)));
  if (missing.length) throw new Error(`Light/dark themes differ in keys: ${missing.join(', ')}`);
}
assertSameKeys(light, dark);

const owner = (path: string): string => path.slice(0, path.indexOf('.'));

/**
 * Semantic values reference primitives. A component token's value references semantic tokens or
 * another token of the same component.
 */
function toCss(value: string, layer: 'semantic' | 'component', token = ''): string {
  return value.replace(REF, (_, path: string) => {
    if (layer === 'semantic') {
      if (!primitiveMap.has(path)) throw new Error(`Unknown primitive reference {${path}}`);
      return `var(${cssName('ref-', path)})`;
    }
    const ownComponent = componentPaths.has(path) && path !== token && owner(path) === owner(token);
    if (!semanticPaths.has(path) && !ownComponent)
      throw new Error(
        `${token}: component tokens reference semantic tokens or their own component: {${path}}`,
      );
    return `var(${cssName('', path)})`;
  });
}

function declarations(list: FlatToken[], layer: 'semantic' | 'component', indent = '  '): string {
  return list
    .map((t) =>
      THEME_PROPERTIES.has(t.path)
        ? `${indent}${t.path}: ${t.value};`
        : `${indent}${cssName('', t.path)}: ${toCss(t.value, layer, t.path)};`,
    )
    .join('\n');
}

const header = `/* Generated by tokens/build-tokens.mts from tokens.json. Do not edit by hand. */`;

// ---- Density ----------------------------------------------------------------

/**
 * `[data-density='compact']` re-declares base control tokens on any element. It comes after the
 * :root block, so on the root element it wins at equal specificity and reaches overlays too.
 * Component tokens that alias control tokens follow because `[data-density]` is one of the scopes
 * that re-declare them. Component tokens with a compact value of their own (`component-compact`)
 * are re-declared after the component block, and on the scopes nested in the region, which would
 * reset them to the default otherwise.
 */
function compactDensityCss(): string {
  const basePaths = new Set(base.map((t) => t.path));
  const unknown = [
    ...compact.filter((t) => !basePaths.has(t.path)),
    ...componentCompact.filter((t) => !componentPaths.has(t.path)),
  ].map((t) => t.path);
  if (unknown.length)
    throw new Error(`Compact density overrides unknown tokens: ${unknown.join(', ')}`);
  return `
[data-density='compact'] {
${declarations(compact, 'semantic')}
}

[data-density='compact'],
[data-density='compact'] :is([data-theme], .ui-theme-scope) {
${declarations(componentCompact, 'component')}
}
`;
}

/**
 * The token stylesheet. With `systemDark` it switches to the dark tokens under
 * `prefers-color-scheme: dark` unless `data-theme='light'` is set (`ui-kit.scss`). The embed
 * stylesheet leaves that block out: a host app chooses its own theme, so only an explicit
 * `[data-theme='dark']` turns the kit dark there.
 */
function tokensCss(systemDark: boolean): string {
  const media = systemDark
    ? `
@media (prefers-color-scheme: dark) {
  /* :where() keeps the specificity of :root, so app overrides on :root also win in dark mode. */
  :root:where(:not([data-theme='light'])) {
${declarations(dark, 'semantic', '    ')}
  }
}
`
    : '';
  return `${header}
:root {
${primitives.map((t) => `  ${cssName('ref-', t.path)}: ${t.value};`).join('\n')}
${declarations(base, 'semantic')}
}

:root,
[data-theme='light'] {
${declarations(light, 'semantic')}
}
${media}
[data-theme='dark'] {
${declarations(dark, 'semantic')}
}

/*
 * Component tokens are re-declared on every themed scope so they follow nested themes, on every
 * density region so they follow its control tokens, and on .ui-theme-scope so they follow
 * semantic tokens overridden on that element. Override component
 * tokens on the same selectors (ui.$theme-scopes) or nested scopes reset them.
 */
:root,
[data-theme],
[data-density],
.ui-theme-scope {
${declarations(component, 'component')}
}
${compactDensityCss()}`;
}

const css = tokensCss(true);

// ---- Contrast validation --------------------------------------------------

function resolveColor(theme: FlatToken[], path: string): string {
  const token = theme.find((t) => t.path === path) ?? base.find((t) => t.path === path);
  if (!token) throw new Error(`Contrast check: unknown token ${path}`);
  const ref = /^\{([^}]+)\}$/.exec(token.value);
  const value = ref ? primitiveMap.get(ref[1]) : token.value;
  if (!value || !/^#[0-9a-f]{6}$/i.test(value))
    throw new Error(`Contrast check: ${path} is not a hex color`);
  return value;
}

function luminance(hex: string): number {
  const channels = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const [r, g, b] = channels.map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

function contrast(a: string, b: string): number {
  const [l1, l2] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (l1 + 0.05) / (l2 + 0.05);
}

const TEXT = 4.5;
const UI = 3;
const contrastPairs: [fg: string, bg: string, min: number][] = [
  ['color.text', 'color.bg', TEXT],
  ['color.text', 'color.surface', TEXT],
  ['color.text', 'color.surface-muted', TEXT],
  ['color.text', 'color.surface-active', TEXT],
  ['color.text-muted', 'color.bg', TEXT],
  ['color.text-muted', 'color.surface', TEXT],
  ['color.text-muted', 'color.surface-muted', TEXT],
  ['color.text-muted', 'color.surface-raised', TEXT],
  ['color.text-muted', 'color.surface-hover', TEXT],
  // Muted icons (menu items, toast close) on pressed/hovered menu items.
  ['color.text-muted', 'color.surface-active', UI],
  ['color.text', 'color.surface-hover', TEXT],
  ['color.text-inverse', 'color.text-muted', TEXT],
  ['color.text-inverse', 'color.text', TEXT],
  ['color.primary-contrast', 'color.primary', TEXT],
  ['color.primary-contrast', 'color.primary-hover', TEXT],
  ['color.primary-contrast', 'color.primary-active', TEXT],
  ['color.danger-contrast', 'color.danger', TEXT],
  ['color.danger-contrast', 'color.danger-hover', TEXT],
  ['color.success-contrast', 'color.success', TEXT],
  ['color.warning-contrast', 'color.warning', TEXT],
  ['color.primary-text', 'color.bg', TEXT],
  ['color.primary-text', 'color.primary-subtle', TEXT],
  ['color.primary-text', 'color.surface-raised', TEXT],
  // Check marks of menu items on hover.
  ['color.primary-text', 'color.surface-active', UI],
  ['color.text', 'color.primary-subtle', TEXT],
  // Option descriptions on the active option.
  ['color.text-muted', 'color.primary-subtle', TEXT],
  ['color.danger-text', 'color.surface', TEXT],
  // Step errors of ui-stepper on the page.
  ['color.danger-text', 'color.bg', TEXT],
  ['color.danger-text', 'color.surface-raised', TEXT],
  // Danger menu items on hover.
  ['color.danger-text', 'color.surface-active', TEXT],
  ['color.danger-text', 'color.danger-subtle', TEXT],
  ['color.success-text', 'color.success-subtle', TEXT],
  ['color.warning-text', 'color.warning-subtle', TEXT],
  ['color.info-text', 'color.info-subtle', TEXT],
  // Solid info badges.
  ['color.primary-contrast', 'color.info', TEXT],
  // Alert text on the tinted tone backgrounds.
  ['color.text', 'color.info-subtle', TEXT],
  ['color.text', 'color.success-subtle', TEXT],
  ['color.text', 'color.warning-subtle', TEXT],
  ['color.text', 'color.danger-subtle', TEXT],
  // Alert borders.
  ['color.info', 'color.info-subtle', UI],
  ['color.success', 'color.success-subtle', UI],
  ['color.warning', 'color.warning-subtle', UI],
  ['color.danger', 'color.danger-subtle', UI],
  // Progress bar indicators on their track.
  ['color.primary', 'color.surface-muted', UI],
  ['color.success', 'color.surface-muted', UI],
  ['color.warning', 'color.surface-muted', UI],
  ['color.danger', 'color.surface-muted', UI],
  // Avatar initials on their accent backgrounds.
  ['color.accent-1-text', 'color.accent-1-bg', TEXT],
  ['color.accent-2-text', 'color.accent-2-bg', TEXT],
  ['color.accent-3-text', 'color.accent-3-bg', TEXT],
  ['color.accent-4-text', 'color.accent-4-bg', TEXT],
  ['color.accent-5-text', 'color.accent-5-bg', TEXT],
  ['color.accent-6-text', 'color.accent-6-bg', TEXT],
  ['color.accent-7-text', 'color.accent-7-bg', TEXT],
  ['color.accent-8-text', 'color.accent-8-bg', TEXT],
  ['color.border-control', 'color.bg', UI],
  ['color.border-control', 'color.surface', UI],
  ['color.border-control', 'color.control-bg', UI],
  ['color.focus-ring', 'color.bg', UI],
  ['color.focus-ring', 'color.surface', UI],
  ['color.focus-ring', 'color.surface-muted', UI],
  ['color.focus-ring', 'color.surface-active', UI],
  ['color.focus-ring', 'color.primary-subtle', UI],
  ['color.primary', 'color.surface', UI],
  ['color.danger', 'color.surface', UI],
  // Slider thumbs and fill on the page and on cards.
  ['color.primary', 'color.bg', UI],
  ['color.danger', 'color.bg', UI],
  ['color.text', 'color.surface-raised', TEXT],
  ['color.info', 'color.surface-raised', UI],
  ['color.success', 'color.surface-raised', UI],
  ['color.warning', 'color.surface-raised', UI],
  ['color.danger', 'color.surface-raised', UI],
];

const failures: string[] = [];
for (const [name, theme] of [
  ['light', light],
  ['dark', dark],
] as const) {
  for (const [fg, bg, min] of contrastPairs) {
    const ratio = contrast(resolveColor(theme, fg), resolveColor(theme, bg));
    if (ratio < min) failures.push(`[${name}] ${fg} on ${bg}: ${ratio.toFixed(2)} < ${min}`);
  }
}
if (failures.length) {
  console.error(`WCAG contrast check failed:\n  ${failures.join('\n  ')}`);
  process.exit(1);
}

// ---- Docs data -------------------------------------------------------------

/** Docs show semantic tokens with their resolved primitive values, e.g. `#4f46e5`. */
const resolvePrimitives = (value: string): string =>
  value.replace(REF, (_, path: string) => primitiveMap.get(path) ?? path);

const themeValue = (theme: FlatToken[], path: string): string =>
  resolvePrimitives(theme.find((t) => t.path === path)?.value ?? '');

/** `{ compact }` when density overrides the token at `path`, else nothing. */
function compactDoc(
  overrides: FlatToken[],
  path: string,
  display: (value: string) => string,
): Pick<TokenDoc, 'compact'> {
  const token = overrides.find((t) => t.path === path);
  return token ? { compact: display(token.value) } : {};
}

const docs: TokenDoc[] = [
  ...primitives.map((t) => ({
    name: cssName('ref-', t.path),
    layer: 'primitive' as const,
    light: t.value,
    dark: t.value,
  })),
  ...base.map((t) => ({
    name: cssName('', t.path),
    layer: 'semantic' as const,
    light: resolvePrimitives(t.value),
    dark: resolvePrimitives(t.value),
    ...compactDoc(compact, t.path, resolvePrimitives),
  })),
  ...light
    .filter((t) => !THEME_PROPERTIES.has(t.path))
    .map((t) => ({
      name: cssName('', t.path),
      layer: 'semantic' as const,
      light: themeValue(light, t.path),
      dark: themeValue(dark, t.path),
    })),
  ...component.map((t) => ({
    name: cssName('', t.path),
    layer: 'component' as const,
    light: toCss(t.value, 'component', t.path),
    dark: toCss(t.value, 'component', t.path),
    ...compactDoc(componentCompact, t.path, (value) => toCss(value, 'component', t.path)),
  })),
];

const ts = `${header}
export interface UiTokenDoc {
  name: string;
  layer: 'primitive' | 'semantic' | 'component';
  light: string;
  dark: string;
  /** The value inside \`[data-density='compact']\`, for the tokens density changes. */
  compact?: string;
}

export const UI_TOKENS: readonly UiTokenDoc[] = ${JSON.stringify(docs, null, 2)};
`;

writeFileSync(resolve(libRoot, 'styles/tokens.css'), css);
writeFileSync(resolve(libRoot, 'styles/_tokens.scss'), css);
writeFileSync(resolve(libRoot, 'styles/_tokens-embed.scss'), tokensCss(false));
writeFileSync(resolve(here, 'tokens.generated.ts'), ts);

// ---- Docs tables -------------------------------------------------------------

/** Replaces the text between the `start` and `end` markers, when both exist. */
function replaceSection(text: string, start: string, end: string, table: string): string {
  const from = text.indexOf(start);
  const to = text.indexOf(end);
  if (from < 0 || to < from) return text;
  return `${text.slice(0, from)}${start}\n${table}\n${text.slice(to)}`;
}

const tokenTable = [
  '| Token | Layer | Light | Dark |',
  '| --- | --- | --- | --- |',
  ...docs
    .filter((d) => d.layer !== 'primitive')
    .map((d) => `| \`${d.name}\` | ${d.layer} | \`${d.light}\` | \`${d.dark}\` |`),
].join('\n');

/**
 * Compact semantic tokens as a JSX table for the Tokens docs page (its MDX has no GFM tables),
 * one row per group and one column per size: `control.height.sm` is row
 * `--ui-control-height-*`, column sm, as "default → **compact**".
 */
function densityTable(): string {
  const groups = new Map<string, Map<string, FlatToken>>();
  for (const t of compact) {
    const cut = t.path.lastIndexOf('.');
    const group = t.path.slice(0, cut);
    groups.set(group, (groups.get(group) ?? new Map()).set(t.path.slice(cut + 1), t));
  }
  const sizes = [...new Set([...groups.values()].flatMap((row) => [...row.keys()]))];
  const cell = (t: FlatToken | undefined): string =>
    t
      ? `<td>${themeValue(base, t.path)} → <strong>${resolvePrimitives(t.value)}</strong></td>`
      : '<td />';
  const head = sizes.map((size) => `<th>${size}</th>`).join('');
  return [
    '<table>',
    '  <thead>',
    `    <tr><th>Token</th>${head}</tr>`,
    '  </thead>',
    '  <tbody>',
    ...[...groups].map(([group, row]) => {
      const cells = sizes.map((size) => cell(row.get(size))).join('');
      // A string expression: MDX would read the bare `*` as the start of emphasis.
      return `    <tr><td><code>{'${cssName('', group)}-*'}</code></td>${cells}</tr>`;
    }),
    '  </tbody>',
    '</table>',
  ].join('\n');
}

const prettier = await import('prettier');

const readmePath = resolve(libRoot, 'README.md');
const readme = replaceSection(
  readFileSync(readmePath, 'utf8'),
  '<!-- tokens:start -->',
  '<!-- tokens:end -->',
  tokenTable,
);
// Keep the README stable under `pnpm format`.
const readmeOptions = (await prettier.resolveConfig(readmePath)) ?? {};
writeFileSync(
  readmePath,
  await prettier.format(readme, { ...readmeOptions, filepath: readmePath }),
);

// MDX is outside the format globs, so the page gets the table as generated.
const tokensPagePath = resolve(libRoot, 'docs/tokens.mdx');
writeFileSync(
  tokensPagePath,
  replaceSection(
    readFileSync(tokensPagePath, 'utf8'),
    '{/* density:start */}',
    '{/* density:end */}',
    densityTable(),
  ),
);

console.log(
  `Tokens: ${primitives.length} primitive, ${base.length + light.length} semantic, ${component.length} component. Contrast OK.`,
);

// ---- Breakpoints -------------------------------------------------------------

/**
 * Breakpoints are Sass and TypeScript values only: media queries cannot read custom properties,
 * so they are never emitted into tokens.css.
 */
async function buildBreakpoints(source: TokenTree): Promise<void> {
  const entries = flatten(source).map((t) => {
    if (!/^[a-z][a-z0-9]*$/.test(t.path))
      throw new Error(`Breakpoint name ${t.path} is not a word`);
    const rem = /^(\d+(?:\.\d+)?)rem$/.exec(t.value);
    if (!rem) throw new Error(`Breakpoint ${t.path} must be in rem: ${t.value}`);
    return { name: t.path, value: t.value, rem: Number(rem[1]) };
  });
  entries.forEach((e, i) => {
    if (i > 0 && e.rem <= entries[i - 1].rem)
      throw new Error(`Breakpoints must ascend: ${entries[i - 1].name} >= ${e.name}`);
  });

  // A silent comment: a /* */ header would be copied into every stylesheet that uses the mixins.
  const scss = `// Generated by tokens/build-tokens.mts from tokens.json. Do not edit by hand.
@use 'sass:map';

/// Named viewport widths, smallest first: \`@each $name, $width in ui.$breakpoints { ... }\`.
$breakpoints: (
${entries.map((e) => `  ${e.name}: ${e.value},`).join('\n')}
);

@function _width($name) {
  @if not map.has-key($breakpoints, $name) {
    @error 'Unknown breakpoint #{$name}. Use one of: #{map.keys($breakpoints)}.';
  }

  @return map.get($breakpoints, $name);
}

/// Styles from the breakpoint width up: \`@include ui.up(md) { ... }\`.
@mixin up($name) {
  @media (width >= #{_width($name)}) {
    @content;
  }
}

/// Styles below the breakpoint width. Never overlaps with \`up($name)\` at the boundary.
@mixin down($name) {
  @media (width < #{_width($name)}) {
    @content;
  }
}
`;

  const ts = `${header}
/** Media queries of the named breakpoints, for the CDK \`BreakpointObserver\`, smallest first. */
export const UI_BREAKPOINTS = {
${entries.map((e) => `  ${e.name}: '(min-width: ${e.value})',`).join('\n')}
} as const;

/** A named viewport width of the kit. */
export type UiBreakpoint = keyof typeof UI_BREAKPOINTS;
`;

  const outputs: [path: string, content: string][] = [
    [resolve(libRoot, 'styles/_breakpoints.scss'), scss],
    [resolve(libRoot, 'core/breakpoints.generated.ts'), ts],
  ];
  for (const [path, content] of outputs) {
    const options = (await prettier.resolveConfig(path)) ?? {};
    writeFileSync(path, await prettier.format(content, { ...options, filepath: path }));
  }
  console.log(`Breakpoints: ${entries.map((e) => `${e.name} ${e.value}`).join(', ')}.`);
}

await buildBreakpoints(tokens.breakpoint);

// ---- Spacing names -------------------------------------------------------------

/** The names of the semantic spacing scale as a Sass list, for the `.ui-gap-*` modifiers. */
async function buildSpaceNames(space: TokenTree): Promise<void> {
  const names = flatten(space).map((t) => t.path);
  const path = resolve(libRoot, 'styles/_spacing.scss');
  const scss = `// Generated by tokens/build-tokens.mts from tokens.json. Do not edit by hand.

/// Names of the semantic spacing scale, smallest first: \`--ui-space-<name>\`.
$space-names: ${names.join(', ')};
`;
  const options = (await prettier.resolveConfig(path)) ?? {};
  writeFileSync(path, await prettier.format(scss, { ...options, filepath: path }));
}

await buildSpaceNames(tokens.semantic.base.space as TokenTree);
