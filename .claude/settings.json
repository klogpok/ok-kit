{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "docs/plans",
  "statusLine": {
    "type": "command",
    "command": "node scripts/orchestrator-statusline.mjs",
    "refreshInterval": 10
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-tool-use.mjs\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/orchestrator-heartbeat.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/orchestrator-heartbeat.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
