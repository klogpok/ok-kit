{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "docs/plans",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-tool-use.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
