{
  "name": "ui-kit",
  "version": "0.0.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "ng": "ng",
    "start": "ng serve playground",
    "tokens": "node projects/ui-kit/tokens/build-tokens.mts",
    "build": "pnpm tokens && ng build ui-kit",
    "build:playground": "ng build playground",
    "test": "ng test ui-kit --watch=false",
    "test:coverage": "ng test ui-kit --watch=false --code-coverage && node scripts/check-coverage.mjs",
    "test:playground": "ng test playground --watch=false",
    "test:watch": "ng test ui-kit",
    "lint": "ng lint && stylelint \"projects/**/*.scss\"",
    "format": "prettier --write \"{projects,scripts}/**/*.{ts,mts,mjs,html,scss,json}\"",
    "format:check": "prettier --check \"{projects,scripts}/**/*.{ts,mts,mjs,html,scss,json}\"",
    "storybook": "node scripts/storybook-preflight.mjs && ng run ui-kit:storybook",
    "build-storybook": "ng run ui-kit:build-storybook",
    "test-storybook": "node scripts/check-stories.mjs",
    "test-visual": "node scripts/check-visual.mjs",
    "test-visual:update": "node scripts/check-visual.mjs --update"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.0",
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular-devkit/core": "^20.3.0",
    "@angular-eslint/builder": "20.7.0",
    "@angular/animations": "^20.3.0",
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/assistant": "^5.3.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^3.2.0",
    "angular-eslint": "20.7.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.0",
    "ng-packagr": "^20.3.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "storybook": "10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "^7.1.11",
    "vitest": "^3.2.0"
  }
}
